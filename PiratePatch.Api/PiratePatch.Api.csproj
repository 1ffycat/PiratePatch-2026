<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PiratePatch.Api</RootNamespace>
    <!-- Source-generated validation for minimal APIs needs interceptors (.NET 10). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PiratePatch.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Pinned: PDFsharp 6.5.0 throws PdfSharpLicenseException when opening a PDF without a licence. Stay on 6.2.x. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- Overrides the vulnerable version PDFsharp depends on. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
