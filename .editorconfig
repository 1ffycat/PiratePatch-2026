root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{nix,json,yml,yaml,js,ts,svelte,css,html,md,sql}]
indent_size = 2

[*.{cs,c}]
indent_size = 4

[*.cs]
# Plain ILogger calls are fine at this scale; source-generated logging would only add noise.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
